//users sections
model Role {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(50)

  users User[]

  @@map("roles")
}

model User {
  id       String @id @default(cuid())
  username String @unique @db.VarChar(100)
  password String @db.VarChar(100)

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  confirmedOrders ConfirmedOrder[]
  sessions        Session[]

  @@map("users")
}

model Session {
  sessionId String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userAgent String?
  expiresAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  @@map("sessions")
}

enum KeyTypes {
  PRINTER
  WEBAPP
}

model ApiKey {
  id         String   @id @default(cuid())
  hashKey    String   @unique @map("hash_key")
  prefix     String
  lastDigits String   @map("last_digits")
  type       KeyTypes

  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@map("api_keys")
}
