enum BannerType {
  EVENT
  SPONSOR
}

model Banner {
  id    String     @id @default(cuid())
  label String     @db.VarChar(100)
  type  BannerType

  position    Int
  title       String? @db.VarChar(100)
  description String? @db.VarChar(250)

  website   String?
  instagram String?
  facebook  String?
  telephone String?

  image String?
  color String  @default("fecc01") @db.VarChar(7)

  startsAt    DateTime?
  endsAt      DateTime?
  visibleFrom DateTime  @default(now())

  @@map("banners")
}

model OrderInstruction {
  id       String @id @default(cuid())
  text     String @db.Text
  position Int

  @@map("order_instructions")
}
