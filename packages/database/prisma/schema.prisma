generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma_client"
}

datasource db {
  provider = "mysql"
}

//TODO: implement tenancy settings in future
model Sagra {
  id   String @id @default(cuid())
  name String @default("MySagra") @db.VarChar(100)

  // stats settings and data
  lastClosingAt        DateTime @default(now())
  statsIntervalMinutes Int      @default(60)

  settings Settings?

  @@map("sagra")
}

// 1:1 with Sagra. `data` is validated (and defaulted) by SettingsSchema in @mysagra/schemas
model Settings {
  sagraId String @id
  sagra   Sagra  @relation(fields: [sagraId], references: [id], onDelete: Cascade)

  data      Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
