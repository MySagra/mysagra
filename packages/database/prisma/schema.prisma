generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma_client"
}

datasource db {
  provider = "mysql"
}

//TODO: implement tenancy settings in future
model Sagra {
  id   String @id @default(cuid())
  name String @default("MySagra") @db.VarChar(100)

  // stats settings and data
  lastClosingAt        DateTime @default(now())
  statsIntervalMinutes Int      @default(60)

  @@map("sagra")
}
